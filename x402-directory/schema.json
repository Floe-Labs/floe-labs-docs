{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.floelabs.xyz/schemas/floe-directory-v1.json",
  "title": "Floe x402 Directory Entry",
  "type": "object",
  "required": ["id", "name", "provider", "description", "resource", "method", "category", "x402Version", "network", "asset", "priceUsd", "floeCompatible", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "provider": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "resource": { "type": "string", "format": "uri" },
    "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
    "category": {
      "enum": [
        "web-search", "social-news", "crypto-data", "risk-security",
        "llm-inference", "media-generation", "browser-compute", "storage",
        "identity-reputation", "payments-commerce", "infra-gateway", "agent-tooling"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "x402Version": { "enum": [1, 2] },
    "network": { "type": "string" },
    "asset": { "type": "string" },
    "priceUsd": { "type": "string" },
    "pricingModel": { "enum": ["fixed-per-call", "tiered", "dynamic", "upto"] },
    "floeCompatible": { "type": "boolean" },
    "status": { "enum": ["verified", "unverified", "preview", "deprecated"] }
  }
}
