{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.floelabs.xyz/schemas/floe-directory-v1.json",
  "title": "Floe x402 Directory Entry",
  "type": "object",
  "required": ["id", "name", "provider", "description", "resource", "method", "category", "x402Version", "network", "asset", "priceUsd", "pricingModel", "floeCompatible", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "provider": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "resource": { "type": "string", "format": "uri" },
    "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
    "category": {
      "enum": [
        "web-search", "social-news",
        "llm-inference", "media-generation", "browser-compute", "storage",
        "identity-reputation", "payments-commerce", "infra-gateway", "agent-tooling"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "x402Version": { "enum": [1, 2] },
    "network": { "type": "string" },
    "asset": { "type": "string" },
    "priceUsd": { "type": "string", "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$" },
    "pricingModel": { "enum": ["fixed-per-call", "tiered", "dynamic", "upto"] },
    "floeCompatible": { "type": "boolean" },
    "status": { "enum": ["verified", "unverified", "preview", "deprecated"] },
    "modelCount": { "type": "integer", "minimum": 0 },
    "modelCatalogUrl": { "type": "string", "format": "uri" },
    "models": {
      "type": "array",
      "description": "Featured/representative models for vendors that expose a model menu (e.g. LLM inference). Not exhaustive — the full live catalog is at modelCatalogUrl. Lets agents pick a model by capability and price.",
      "items": {
        "type": "object",
        "required": ["id", "mode", "inputPer1M", "outputPer1M"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "mode": { "enum": ["chat", "embedding"] },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "inputPer1M": { "type": "number", "minimum": 0, "description": "USD per 1,000,000 input tokens." },
          "outputPer1M": { "type": "number", "minimum": 0, "description": "USD per 1,000,000 output tokens (0 for embeddings)." },
          "contextTokens": { "type": ["integer", "null"] },
          "maxCompletionTokens": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
